include LICENSE NOTICE README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md SUPPORT.md
include uv.lock .mcp.json .gitattributes .gitignore
recursive-include src *.py *.md *.json py.typed
recursive-include docs *.md
recursive-include deployment *.md *.json *.yaml *.py Dockerfile
recursive-include scripts *.py *.ps1 *.json *.txt *.rst LICENSE
recursive-include patches *.patch *.md *.json
recursive-include evaluation *.py *.md *.json
recursive-include tests *.py
recursive-include skills *.md *.py *.json *.yaml *.sh
recursive-include assets *.png *.svg
recursive-include launchers *
recursive-include openai-runtime *
recursive-include .claude-plugin *.json
recursive-include .codex-plugin *.json
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod] .DS_Store
prune private
prune dist
prune build
prune .venv
prune .git

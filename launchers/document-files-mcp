#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -x "$ROOT/python/bin/python3" ]; then
  exec "$ROOT/python/bin/python3" -I "$ROOT/launchers/run.py" mcp_server "$@"
fi
if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" -I "$ROOT/launchers/run.py" mcp_server "$@"
fi
printf '%s\n' 'Document Files runtime missing. Install a platform release, or provision the development environment explicitly.' >&2
exit 127
